{
    "name": "aternos/modrinth-api",
    "description": "PHP Client for the Modrinth API. This client is based on the openapi spec.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "modrinth",
        "mods",
        "plugins",
        "minecraft",
        "php",
        "api"
    ],
    "authors": [
        {
            "name": "Aternos GmbH",
            "homepage": "https://aternos.gmbh"
        }
    ],
    "homepage": "https://github.com/aternosorg/php-modrinth-api",
    "require": {
        "php": "^8.4.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.10",
        "guzzlehttp/psr7": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "scripts": {
        "generate": "rm -rf src/Api src/Model docs/Api docs/Model && openapi-generator-cli generate -c config.yaml && rm -rf tests/Api tests/Model"
    },
    "autoload": {
        "psr-4": {
            "Aternos\\ModrinthApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aternos\\ModrinthApi\\Tests\\": "tests/"
        }
    }
}
